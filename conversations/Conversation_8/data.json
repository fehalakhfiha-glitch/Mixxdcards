{
  "id": 8,
  "title": "محادثة 8- طلب في المطعم",
  "dialogue": [
    {
      "speaker": "A",
      "gender": "male",
      "en": "Can I have a sandwich, please?",
      "ar": "هل يمكنني الحصول على شطيرة، من فضلك؟"
    },
    {
      "speaker": "B",
      "gender": "female",
      "en": "Sure! Chicken or beef?",
      "ar": "بالطبع! دجاج أم لحم بقري؟"
    },
    {
      "speaker": "A",
      "gender": "male",
      "en": "Chicken, please.",
      "ar": "دجاج، من فضلك."
    },
    {
      "speaker": "B",
      "gender": "female",
      "en": "Here you go.",
      "ar": "تفضل."
    }
  ]
