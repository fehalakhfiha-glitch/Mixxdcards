      "gender": "female",
      "en": "Yes, I do.",
      "ar": "نعم."
    },
    {
      "speaker": "A",
      "gender": "male",
      "en": "How many cups?",
      "ar": "كم كوبًا؟"
    },
    {
      "speaker": "B",
      "gender": "female",
      "en": "Two cups.",
      "ar": "كوبان."
    }
  ]
