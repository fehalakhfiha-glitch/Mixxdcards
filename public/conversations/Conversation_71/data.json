{
  "id": 71,
  "title": "محادثة 71 – السؤال عن الطريق",
  "dialogue": [
    {
      "speaker": "A",
      "gender": "male",
      "en": "Is there a supermarket near here?",
      "ar": "هل يوجد سوبرماركت قريب من هنا؟"
    },
    {
      "speaker": "B",
      "gender": "female",
      "en": "Yes, there is one on the corner.",
      "ar": "نعم، يوجد واحد في الزاوية."
    },
    {
      "speaker": "A",
      "gender": "male",
      "en": "Thank you.",
      "ar": "شكرًا."
    },
    {
      "speaker": "B",
      "gender": "female",
      "en": "You're welcome.",
      "ar": "على الرحب والسعة."
    }
  ]
}